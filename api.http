@baseUrl = http://localhost:8000
@password = Pass1234!

#################################################
# ҮҮРЭГ → ХЭРЭГЛЭГЧИЙН ТОХИРГОО (зөвхөн эндээс засна)
# Хэрэглэгч солих бол: erkaToken, surenToken, dorjToken,
# batToken, res1Token, res2Token-ийн аль нэгийг сонгоно
#################################################
@researcherToken = {{res1Token}}
@adminToken = {{erkaToken}}
@reviewerToken = {{surenToken}}

#################################################
# 1. НЭВТРЭХ
#################################################

### erka
# @name loginErka
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "erka", "password": "{{password}}" }

###
@erkaToken = {{loginErka.response.body.access}}

### suren
# @name loginSuren
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "suren", "password": "{{password}}" }

###
@surenToken = {{loginSuren.response.body.access}}

### dorj
# @name loginDorj
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "dorj", "password": "{{password}}" }

###
@dorjToken = {{loginDorj.response.body.access}}

### bat
# @name loginBat
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "bat", "password": "{{password}}" }

###
@batToken = {{loginBat.response.body.access}}

### res1
# @name loginRes1
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "res1", "password": "{{password}}" }

###
@res1Token = {{loginRes1.response.body.access}}

### res2
# @name loginRes2
POST {{baseUrl}}/api/token/
Content-Type: application/json

{ "username": "res2", "password": "{{password}}" }

###
@res2Token = {{loginRes2.response.body.access}}

### Token шинэчлэх (res1-ийн жишээ)
POST {{baseUrl}}/api/token/refresh/
Content-Type: application/json

{ "refresh": "{{loginRes1.response.body.refresh}}" }


#################################################
# 2. ХЭРЭГЛЭГЧ
#################################################

### Миний профайл (судлаач)
GET {{baseUrl}}/api/users/me/
Authorization: Bearer {{researcherToken}}

### Хэрэглэгчдийн жагсаалт: id, username, role харах
GET {{baseUrl}}/api/users/
Authorization: Bearer {{adminToken}}


#################################################
# 3. СУДЛААЧ: ПРОТОКОЛ ҮҮСГЭХ, ХАВСРАЛТ, ИЛГЭЭХ
#################################################

### Протокол үүсгэх 
# @name createProposal
POST {{baseUrl}}/api/proposals/
Authorization: Bearer {{researcherToken}}
Content-Type: application/json

{
  "title": "Туршилтын судалгаа",
  "summary": "Энэ бол REST Client-ээр үүсгэсэн хураангуй.",
  "methodology": "Асуумж судалгаа"
}

###
@proposalId = {{createProposal.response.body.id}}

### Протоколын жагсаалт
GET {{baseUrl}}/api/proposals/
Authorization: Bearer {{researcherToken}}

### Протоколын дэлгэрэнгүй
GET {{baseUrl}}/api/proposals/{{proposalId}}/
Authorization: Bearer {{researcherToken}}

### Файл хавсаргах 
POST {{baseUrl}}/api/documents/
Authorization: Bearer {{researcherToken}}
Content-Type: multipart/form-data; boundary=----IRB

------IRB
Content-Disposition: form-data; name="proposal"

{{proposalId}}
------IRB
Content-Disposition: form-data; name="document_type"

PROTOCOL
------IRB
Content-Disposition: form-data; name="file"; filename="protocol.pdf"
Content-Type: application/pdf

< ./public/docs/MUST_IRB_SOP.pdf
------IRB--

### Хавсралтуудын жагсаалт
GET {{baseUrl}}/api/documents/
Authorization: Bearer {{researcherToken}}

### Хорооны өмнө илгээх (Хэрэв submit action байгаа бол)
POST {{baseUrl}}/api/proposals/{{proposalId}}/submit/
Authorization: Bearer {{researcherToken}}


#################################################
# 4. АДМИН: ШҮҮГЧ ОНООХ
#################################################

### Шүүгч оноох (Зөвхөн админ эсвэл нарийн бичиг)
POST {{baseUrl}}/api/proposals/{{proposalId}}/assign-reviewer/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "reviewer_id": 3 }


#################################################
# 5. ШҮҮГЧ: REVIEW
#################################################

### Оноогдсон протоколууд
GET {{baseUrl}}/api/proposals/
Authorization: Bearer {{reviewerToken}}

### Review бичих
# @name createReview
POST {{baseUrl}}/api/reviews/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{
  "proposal": {{proposalId}},
  "decision": "APPROVED",
  "comments": "Туршилтын дүгнэлт"
}

###
@reviewId = {{createReview.response.body.id}}

### Review-ийн жагсаалт
GET {{baseUrl}}/api/reviews/
Authorization: Bearer {{reviewerToken}}

### Review засах
PATCH {{baseUrl}}/api/reviews/{{reviewId}}/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{ "comments": "Засвар хийв" }


#################################################
# 6. ХУРАЛ БА ШИЙДВЭР
#################################################

### Хурал үүсгэх 
# @name createMeeting
POST {{baseUrl}}/api/meetings/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "IRB хурал",
  "meeting_date": "2026-11-05T10:00:00Z"
}

###
@meetingId = {{createMeeting.response.body.id}}

### Хуралуудын жагсаалт
GET {{baseUrl}}/api/meetings/
Authorization: Bearer {{adminToken}}

### Шийдвэр бүртгэх
POST {{baseUrl}}/api/meetings/{{meetingId}}/record_decision/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "proposal_id": {{proposalId}},
  "decision": "APPROVED",
  "meeting_minutes": "Хурлаар батлав"
}


#################################################
# 7. МЭДЭГДЭЛ
#################################################

### Судлаачийн мэдэгдлүүд
GET {{baseUrl}}/api/notifications/
Authorization: Bearer {{reviewerToken}}

### Уншаагүй мэдэгдлийн тоо
GET {{baseUrl}}/api/notifications/unread_count/
Authorization: Bearer {{researcherToken}}

### Бүгдийг уншсан болгох
POST {{baseUrl}}/api/notifications/mark_all_as_read/
Authorization: Bearer {{reviewerToken}}